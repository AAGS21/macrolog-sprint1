# Desarrollo: la desactivación de confirmación debe ser explícita.
NODE_ENV=development
NODE_VERSION=22.16.0
PORT=3000
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
REQUIRE_EMAIL_CONFIRMATION=false
DATABASE_URL=
# Para activar RF-02, completar todas las variables siguientes.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=MacroLog
APP_BASE_URL=
# Producción: NODE_ENV=production y REQUIRE_EMAIL_CONFIRMATION=true obligatorios.
# APP_BASE_URL debe ser la URL pública HTTPS, sin credenciales, query ni fragmento.
# HTTP solo se permite con localhost en desarrollo. No copiar credenciales reales aquí.
